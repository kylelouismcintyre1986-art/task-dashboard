{
  "name": "task-dashboard",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "framer-motion": "^12.23.9",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.5",
    "web-vitals": "^5.1.0"
  },
  "overrides": {
    "@svgr/webpack": "^8.0.1",
    "@adobe/css-tools": "^4.3.1"
  },
  "scripts": {
    "start": "vite --port 3000",
    "start:hydrated": "node scripts/run-with-env.cjs VITE_ENABLE_DATA_HYDRATION=true vite --port 3000",
    "desktop": "electron electron/main.cjs --dev",
    "build": "vite build",
    "build:hydrated": "node scripts/run-with-env.cjs VITE_ENABLE_DATA_HYDRATION=true vite build",
    "build:clean": "node scripts/run-with-env.cjs VITE_ENABLE_DATA_HYDRATION=false vite build",
    "preview": "vite preview",
    "preview:hydrated": "node scripts/run-with-env.cjs VITE_ENABLE_DATA_HYDRATION=true vite preview",
    "build:desktop": "npm run build && electron-builder",
    "test": "vitest run",
    "build:css": "tailwindcss build src/index.css -o src/output.css",
    "watch:css": "tailwindcss -i src/index.css -o src/output.css --watch"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.3",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^26.1.0",
    "msw": "^2.12.9",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fermentationlab.pro",
    "productName": "FermentationLab Pro",
    "publish": null,
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "FermentationLab-Pro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
